<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#087F5B"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Header Title -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customers"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Manage your customers"
                        android:textColor="#D8F3EA"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Search -->

                <TextView
                    android:id="@+id/btnCustomerSearch"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />

                <!-- Filter -->

                <TextView
                    android:id="@+id/btnCustomerFilter"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="⚱"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <!-- Menu -->

                <TextView
                    android:id="@+id/btnCustomerMenu"
                    android:layout_width="35dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="⋮"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Part 2 will continue here -->
        <!-- ================= SEARCH BAR ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-20dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="10dp">

                <!-- Search Icon -->

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#263238"
                    android:textSize="28sp" />

                <!-- Search Input -->

                <EditText
                    android:id="@+id/etSearchCustomer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search customers by name or phone..."
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:textColor="#263238"
                    android:textColorHint="#78909C"
                    android:textSize="14sp" />

                <!-- Filter Button -->

                <TextView
                    android:id="@+id/btnSearchFilter"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="☷"
                    android:textColor="#263238"
                    android:textSize="23sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Space -->

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp" />


        <!-- Part 3 will continue here -->

        <!-- ================= CUSTOMER STATISTICS ================= -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">


                <!-- ========== TOTAL CUSTOMERS ========== -->

                <androidx.cardview.widget.CardView
                    android:layout_width="150dp"
                    android:layout_height="125dp"
                    app:cardBackgroundColor="#EAF8F3"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#D0F1E5"
                            android:gravity="center"
                            android:text="👥"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tvTotalCustomers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="128"
                            android:textColor="#087F5B"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Customers"
                            android:textColor="#263238"
                            android:textSize="12sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- ========== ACTIVE CUSTOMERS ========== -->

                <androidx.cardview.widget.CardView
                    android:layout_width="150dp"
                    android:layout_height="125dp"
                    android:layout_marginStart="10dp"
                    app:cardBackgroundColor="#EEF6FF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#DCEBFF"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#2563EB"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveCustomers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="102"
                            android:textColor="#2563EB"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Customers"
                            android:textColor="#263238"
                            android:textSize="12sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- ========== INACTIVE CUSTOMERS ========== -->

                <androidx.cardview.widget.CardView
                    android:layout_width="150dp"
                    android:layout_height="125dp"
                    android:layout_marginStart="10dp"
                    app:cardBackgroundColor="#FFF7E8"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#FFF0C9"
                            android:gravity="center"
                            android:text="◷"
                            android:textColor="#F4B942"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/tvInactiveCustomers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="18"
                            android:textColor="#D99800"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inactive Customers"
                            android:textColor="#263238"
                            android:textSize="12sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- ========== NEW CUSTOMERS ========== -->

                <androidx.cardview.widget.CardView
                    android:layout_width="150dp"
                    android:layout_height="125dp"
                    android:layout_marginStart="10dp"
                    app:cardBackgroundColor="#F5F0FF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="#E8DEFF"
                            android:gravity="center"
                            android:text="＋"
                            android:textColor="#7C3AED"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNewCustomers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="12"
                            android:textColor="#7C3AED"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New This Month"
                            android:textColor="#263238"
                            android:textSize="12sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </HorizontalScrollView>


        <!-- Part 4 will continue here -->

        <!-- ================= ALL CUSTOMERS HEADER ================= -->

        <LinearLayout
