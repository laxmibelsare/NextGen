<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Light Emerald Background -->
    <solid android:color="#E1F3ED" />

    <!-- Rounded Corners -->
    <corners android:radius="16dp" />

    <!-- Soft Border -->
    <stroke
        android:width="1dp"
        android:color="#D1E9E1" />

    <!-- Small Inner Padding -->
    <padding
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp" />

</shape>