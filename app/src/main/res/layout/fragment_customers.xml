                        android:layout_height="58dp"
                        android:background="#DDF4EC"
                        android:gravity="center"
                        android:text="RS"
                        android:textColor="#087F5B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- CUSTOMER INFORMATION -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCustomerName1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rahul Sharma"
                            android:textColor="#12372A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCustomerPhone1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="☎ 9876543210"
                            android:textColor="#455A64"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvCustomerService1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="🥛 Milk Subscription • 1 Litre • Daily"
                            android:textColor="#607D78"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCustomerAddress1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="📍 Shivaji Nagar, Pune"
                            android:textColor="#607D78"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- STATUS + DETAILS -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCustomerStatus1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E4F6EE"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:text="● Active"
                            android:textColor="#087F5B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnCustomerDetails1"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="#263238"
                            android:textSize="27sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8EFEC" />


                <!-- ================= CUSTOMER 2 ================= -->

                <LinearLayout
                    android:id="@+id/customerRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="115dp"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- PROFILE -->

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="#DDEBFF"
                        android:gravity="center"
                        android:text="SP"
                        android:textColor="#2563EB"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- CUSTOMER INFORMATION -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCustomerName2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sneha Patil"
                            android:textColor="#12372A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCustomerPhone2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="☎ 8765432109"
                            android:textColor="#455A64"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvCustomerService2"
                            android:layout_width="wrap_content"
