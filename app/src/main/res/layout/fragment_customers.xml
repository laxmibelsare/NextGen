                            android:text="💧 Water • 20 Litre • Weekly"
                            android:textColor="#607D78"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCustomerAddress4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
