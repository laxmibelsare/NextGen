<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Selection_FormActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="20dp"
        android:layout_margin="20dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/background">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Your Role"
                android:textColor="@color/deep_green"
                android:textSize="30dp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Let's Personlize your Exeprience"
                android:textSize="20sp"
                android:textStyle="italic"
                android:layout_gravity="center"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCustomer"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="35dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="10dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="15dp">

                    <LinearLayout
                        android:layout_width="125dp"
                        android:layout_height="125dp"
                        android:gravity="center"
                        android:background="@drawable/bg_circle_role">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="100dp"
                            android:src="@drawable/customer_image"
                            android:contentDescription="Customer" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customer"
                            android:textColor="#12372A"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Browse, subscribe and get daily essentials delivered to your doorstep."
                            android:textColor="#52605C"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="@color/white"
                        android:textSize="35sp"
                        android:background="@drawable/bg_customer_arrow" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
        
    </androidx.cardview.widget.CardView>

</LinearLayout>